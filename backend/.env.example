# Backend Configuration
PROJECT_NAME="Zoom Clone Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Database (SQLite default)
DATABASE_URL="sqlite:///./zoom_clone.db"

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# LiveKit SFU Configuration
LIVEKIT_URL="wss://zoom-clone-demo.livekit.cloud"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
